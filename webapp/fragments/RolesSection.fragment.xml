<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <VBox id="rolesSection" visible="false">
        <Title id="_IDGenRolesTitle" text="Roles &amp; Permissions" level="H2" class="sapUiSmallMarginBottom"/>
        <Text id="_IDGenRolesSubtitle" text="Access scopes defined for this application" class="sapUiTinyText sapUiSmallMarginBottom"/>

        <Table id="rolesTable" items="{roles>/list}" noDataText="No roles found">
            <columns>
                <Column id="_IDGenRoleColName"><Text text="Role"/></Column>
                <Column id="_IDGenRoleColDesc"><Text text="Description"/></Column>
                <Column id="_IDGenRoleColPerms"><Text text="Key Permissions"/></Column>
            </columns>
            <items>
                <ColumnListItem id="_IDGenRoleRow">
                    <cells>
                        <ObjectStatus text="{roles>role}" state="Information"/>
                        <Text text="{roles>description}"/>
                        <Text text="{roles>permissions}"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </VBox>
</core:FragmentDefinition>