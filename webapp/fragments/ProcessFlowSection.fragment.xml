<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:suite="sap.suite.ui.commons">
    <VBox id="processflowSection" visible="false">
        <HBox id="_IDGenPFBackRow" alignItems="Center" class="sapUiTinyMarginBottom">
            <Button id="_IDGenBackToDashboardFromPFBtn" icon="sap-icon://nav-back" text="Back to Dashboard" type="Transparent" press=".onBackToDashboard"/>
        </HBox>

        <Title id="_IDGenPFTitle2" text="Procurement Process Flow" level="H2" class="sapUiSmallMarginBottom"/>
        <Text id="_IDGenPFSubtitle2" text="Requisition to goods receipt, per PR" class="sapUiTinyText sapUiSmallMarginBottom"/>

        <Toolbar id="_IDGenPFToolbar">
            <Label id="_IDGenPFPrLabel" text="Select PR:" class="sapUiTinyMarginEnd"/>
            <Select id="pfPrSelect" width="16rem" items="{/PurchaseRequisitions}" change=".onProcessFlowPrChange">
                <core:Item key="{ID}" text="{prNumber}"/>
            </Select>
            <ToolbarSpacer id="_IDGenPFSpacer"/>
            <Button id="_IDGenPFRefresh" icon="sap-icon://refresh" tooltip="Refresh" press=".onRefreshProcessFlow"/>
        </Toolbar>

        <suite:ProcessFlow id="procurementProcessFlow" nodes="{path: 'pf>/nodes'}" lanes="{path: 'pf>/lanes'}" nodePress=".onProcessFlowNodePress" zoomLevel="Three">
            <suite:nodes>
                <suite:ProcessFlowNode
                    laneId="{pf>lane}"
                    nodeId="{pf>nodeId}"
                    title="{pf>title}"
                    texts="{pf>texts}"
                    state="{pf>state}"
                    stateText="{pf>stateText}"
                    children="{pf>children}"
                    focused="{pf>focused}"
                    highlighted="{pf>highlighted}"
                />
            </suite:nodes>
            <suite:lanes>
                <suite:ProcessFlowLaneHeader laneId="{pf>laneId}" iconSrc="{pf>icon}" text="{pf>text}" position="{pf>position}"/>
            </suite:lanes>
        </suite:ProcessFlow>
    </VBox>
</core:FragmentDefinition>