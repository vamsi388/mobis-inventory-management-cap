<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <VBox id="requisitionsSection" visible="false">
        <Toolbar id="_IDGenPRToolbar">
            <Title id="_IDGenPRTitle" text="Purchase Requisitions"/>
            <ToolbarSpacer id="_IDGenPRSpacer"/>
            <Button id="_IDGenCreatePRBtn" text="Create PR" type="Emphasized" icon="sap-icon://add" press=".onCreatePR"/>
            <Button id="_IDGenRefreshPRBtn" icon="sap-icon://refresh" tooltip="Refresh" press=".onRefreshPRs"/>
        </Toolbar>
        <Table id="prTable" items="{ path: '/PurchaseRequisitions', sorter: { path: 'createdAt', descending: true } }" growing="true" growingThreshold="15">
            <columns>
                <Column id="_IDGenPRColNum"><Text id="_IDGenPRColNumTxt" text="PR Number"/></Column>
                <Column id="_IDGenPRColLoc"><Text id="_IDGenPRColLocTxt" text="Location"/></Column>
                <Column id="_IDGenPRColStatus"><Text id="_IDGenPRColStatusTxt" text="Status"/></Column>
                <Column id="_IDGenPRColReq"><Text id="_IDGenPRColReqTxt" text="Requested By"/></Column>
                <Column id="_IDGenPRColApp"><Text id="_IDGenPRColAppTxt" text="Approved By"/></Column>
                <Column id="_IDGenPRColAct" hAlign="End" width="80px"><Text id="_IDGenPRColActTxt" text="Actions"/></Column>
            </columns>
            <items>
                <ColumnListItem id="_IDGenPRRow">
                    <cells>
                        <Text id="_IDGenPRNum" text="{prNumber}"/>
                        <Text id="_IDGenPRLoc" text="{location/name} ({location/locationCode})"/>
                        <ObjectStatus id="_IDGenPRStatus" text="{status}" state="{path:'status', formatter:'.formatter.prStatusState'}"/>
                        <Text id="_IDGenPRReq" text="{requestedBy}"/>
                        <Text id="_IDGenPRApp" text="{approvedBy}"/>
                        <MenuButton id="_IDGenPRActionsBtn" icon="sap-icon://overflow" type="Transparent" buttonMode="Regular" tooltip="Actions" class="phRowActionsBtn">
                            <menu>
                                <Menu id="_IDGenPRActionsMenu">
                                    <MenuItem id="_IDGenSubmitPRMenuItem" text="Submit" icon="sap-icon://paper-plane" visible="{= ${status} === 'DRAFT' }" press=".onSubmitPR"/>
                                    <MenuItem id="_IDGenApprovePRMenuItem" text="Approve" icon="sap-icon://accept" visible="{= ${status} === 'SUBMITTED' }" press=".onApprovePR"/>
                                    <MenuItem id="_IDGenRejectPRMenuItem" text="Reject" icon="sap-icon://decline" visible="{= ${status} === 'SUBMITTED' }" press=".onRejectPR"/>
                                    <MenuItem id="_IDGenCreatePOMenuItem" text="Create PO" icon="sap-icon://cart" visible="{= ${status} === 'APPROVED' }" press=".onCreatePOFromPR"/>
                                </Menu>
                            </menu>
                        </MenuButton>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </VBox>
</core:FragmentDefinition>