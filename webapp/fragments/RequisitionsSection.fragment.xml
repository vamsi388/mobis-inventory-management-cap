<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <VBox
        id="requisitionsSection"
        visible="false"
    >
        <Toolbar id="_IDGenPRToolbar">
            <Title
                id="_IDGenPRTitle"
                text="Purchase Requisitions"
            />
            <ToolbarSpacer id="_IDGenPRSpacer" />
            <Button
                id="_IDGenCreatePRBtn"
                text="Create PR"
                type="Emphasized"
                icon="sap-icon://add"
                press=".onCreatePR"
            />
            <Button
                id="_IDGenRefreshPRBtn"
                icon="sap-icon://refresh"
                tooltip="Refresh"
                press=".onRefreshPRs"
            />
        </Toolbar>
        <Table
            id="prTable"
            items="{ path: '/PurchaseRequisitions', parameters: { $expand: 'location' }, sorter: { path: 'createdAt', descending: true } }"
            growing="true"
            growingThreshold="15"
        >
            <columns>
                <Column id="_IDGenPRColNum">
                    <Text
                        id="_IDGenPRColNumTxt"
                        text="PR Number"
                    />
                </Column>
                <Column id="_IDGenPRColLoc">
                    <Text
                        id="_IDGenPRColLocTxt"
                        text="Location"
                    />
                </Column>
                <Column id="_IDGenPRColStatus">
                    <Text
                        id="_IDGenPRColStatusTxt"
                        text="Status"
                    />
                </Column>
                <Column id="_IDGenPRColReq">
                    <Text
                        id="_IDGenPRColReqTxt"
                        text="Requested By"
                    />
                </Column>
                <Column id="_IDGenPRColApp">
                    <Text
                        id="_IDGenPRColAppTxt"
                        text="Approved By"
                    />
                </Column>
                <Column
                    id="_IDGenPRColAct"
                    hAlign="End"
                    width="80px"
                >
                    <Text
                        id="_IDGenPRColActTxt"
                        text="Actions"
                    />
                </Column>
            </columns>
            <items>
                <ColumnListItem
                    id="_IDGenPRRow"
                    type="Navigation"
                    press=".onOpenPRObjectPage"
                >
                    <cells>
                        <Text
                            id="_IDGenPRNum"
                            text="{prNumber}"
                        />
                        <Text
                            id="_IDGenPRLoc"
                            text="{location/name} ({location/locationCode})"
                        />
                        <ObjectStatus
                            id="_IDGenPRStatus"
                            text="{status}"
                            state="{path:'status', formatter:'.formatter.prStatusState'}"
                        />
                        <Text
                            id="_IDGenPRReq"
                            text="{requestedBy}"
                        />
                        <Text
                            id="_IDGenPRApp"
                            text="{approvedBy}"
                        />
                        <MenuButton
                            id="_IDGenPRActionsBtn"
                            icon="sap-icon://overflow"
                            type="Transparent"
                            buttonMode="Regular"
                            tooltip="Actions"
                            class="phRowActionsBtn"
                        >
                            <menu>
                                <Menu id="_IDGenPRActionsMenu">
                                    <MenuItem
                                        id="_IDGenEditPRMenuItem"
                                        text="Edit"
                                        icon="sap-icon://edit"
                                        enabled="{path:'status', formatter:'.formatter.prCanEdit'}"
                                        press=".onEditPR"
                                    />
                                    <MenuItem
                                        id="_IDGenDeletePRMenuItem"
                                        text="Delete"
                                        icon="sap-icon://delete"
                                        enabled="{path:'status', formatter:'.formatter.prCanDelete'}"
                                        press=".onDeletePR"
                                    />
                                    <MenuItem
                                        id="_IDGenSubmitPRMenuItem"
                                        text="Submit"
                                        icon="sap-icon://paper-plane"
                                        enabled="{path:'status', formatter:'.formatter.prCanSubmit'}"
                                        press=".onSubmitPR"
                                    />
                                    <MenuItem
                                        id="_IDGenSendForApprovalMenuItem"
                                        text="Send for Approval"
                                        icon="sap-icon://forward"
                                        enabled="{path:'status', formatter:'.formatter.prCanSendForApproval'}"
                                        press=".onSendForApproval"
                                    />
                                    <MenuItem
                                        id="_IDGenApprovePRMenuItem"
                                        text="Approve"
                                        icon="sap-icon://accept"
                                        enabled="{path:'status', formatter:'.formatter.prCanApprove'}"
                                        press=".onApprovePR"
                                    />
                                    <MenuItem
                                        id="_IDGenRejectPRMenuItem"
                                        text="Reject"
                                        icon="sap-icon://decline"
                                        enabled="{path:'status', formatter:'.formatter.prCanReject'}"
                                        press=".onRejectPR"
                                    />
                                    <MenuItem
                                        id="_IDGenCreatePOMenuItem"
                                        text="Create PO"
                                        icon="sap-icon://cart"
                                        enabled="{path:'status', formatter:'.formatter.prCanCreatePO'}"
                                        press=".onCreatePOFromPR"
                                    />
                                        <MenuItem
                                        id="_IDGenClosePRMenuItem"
                                        text="Close PR"
                                        icon="sap-icon://complete"
                                        enabled="{path:'status', formatter:'.formatter.prCanClose'}"
                                        press=".onClosePR"
                                    />
                                    <MenuItem
                                        id="_IDGenResubmitPRMenuItem"
                                        text="Resubmit"
                                        icon="sap-icon://reset"
                                        enabled="{path:'status', formatter:'.formatter.prCanResubmit'}"
                                        press=".onResubmitPR"
                                    />
                                </Menu>
                            </menu>
                        </MenuButton>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </VBox>
</core:FragmentDefinition>
