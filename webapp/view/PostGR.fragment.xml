<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">
    <Dialog id="postGRDialog" title="{i18n>postGRDialogTitle}" contentWidth="40rem" resizable="true">
        <content>
            <l:VerticalLayout class="sapUiContentPadding" width="100%">
                <l:content>
                    <Label text="{i18n>grPoLabel}" labelFor="grPoSelect"/>
                    <Select id="grPoSelect" width="100%" change=".onGRPoChange"
                        items="{path: '/PurchaseOrders', filters: [{path: 'status', operator: 'NE', value1: 'CLOSED'}]}">
                        <core:Item key="{ID}" text="{poNumber}"/>
                    </Select>

                    <Label text="{i18n>grLocationLabel}" labelFor="grLocationInput" class="sapUiTinyMarginTop"/>
                    <Input id="grLocationInput" placeholder="{i18n>grLocationPlaceholder}" width="100%"/>

                    <Label text="{i18n>grReceivedByLabel}" labelFor="grReceivedByInput" class="sapUiTinyMarginTop"/>
                    <Input id="grReceivedByInput" placeholder="{i18n>grReceivedByPlaceholder}" width="100%"/>

                    <Title text="{i18n>grItemsTitle}" level="H5" class="sapUiTinyMarginTop"/>
                    <Table items="{grItems>/items}" noDataText=" ">
                        <columns>
                            <Column><Text text="{i18n>colItemOrderedQty}"/></Column>
                            <Column><Text text="{i18n>colItemReceivedQty}"/></Column>
                            <Column><Text text="{i18n>colItemReceiveNow}"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{grItems>orderedQty}"/>
                                    <Text text="{grItems>receivedQty}"/>
                                    <Input value="{grItems>receiveNow}" type="Number"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </l:content>
            </l:VerticalLayout>
        </content>
        <beginButton>
            <Button text="{i18n>btnPost}" type="Emphasized" press=".onSubmitGR"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>btnCancel}" press=".onCancelGRDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>