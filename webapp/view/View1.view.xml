<mvc:View
    controllerName="procurement.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" showHeader="false" busy="{view>/busy}">
        <customHeader>
            <Bar id="_IDGenBar1">
                <contentLeft>
                    <HBox id="_IDGenHBox" alignItems="Center">
                        <Avatar id="_IDGenAvatar" displaySize="S" initials="M" backgroundColor="Accent6" class="sapUiTinyMarginEnd"/>
                        <VBox id="_IDGenVBox">
                            <Title id="_IDGenTitle" text="{i18n>brandName}" level="H4"/>
                            <Text id="_IDGenText" text="{i18n>brandSubtitle}" class="sapUiTinyText"/>
                        </VBox>
                    </HBox>
                </contentLeft>
                <contentRight>
                    <SearchField id="globalSearch" width="16rem" placeholder="{i18n>globalSearchPlaceholder}" class="sapUiTinyMarginEnd"/>
                    <Avatar id="_IDGenAvatar1" displaySize="S" initials="RK"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <IconTabBar id="tabBar" expanded="true" select=".onTabSelect">
                <items>
                    <IconTabFilter id="_IDGenIconTabFilter" key="dashboard" text="{i18n>tabDashboard}" icon="sap-icon://home">
                        <VBox id="_IDGenVBox1" class="sapUiSmallMargin">
                            <HBox id="_IDGenHBox1" class="sapUiSmallMarginBottom">
                                <GenericTile id="_IDGenGenericTile" header="{i18n>tilePRTotal}" subheader="{i18n>tilePRTotalSub}" class="sapUiTinyMarginEnd" press=".onTabPress">
                                    <customData><core:CustomData key="tab" value="requisitions"/></customData>
                                    <TileContent id="_IDGenTileContent"><NumericContent id="_IDGenNumericContent" value="{view>/counts/prTotal}"/></TileContent>
                                </GenericTile>
                                <GenericTile id="_IDGenGenericTile1" header="{i18n>tilePRPending}" subheader="{i18n>tilePRPendingSub}" class="sapUiTinyMarginEnd" press=".onTabPress">
                                    <customData><core:CustomData key="tab" value="requisitions"/></customData>
                                    <TileContent id="_IDGenTileContent1"><NumericContent id="_IDGenNumericContent1" value="{view>/counts/prPending}" valueColor="Critical"/></TileContent>
                                </GenericTile>
                                <GenericTile id="_IDGenGenericTile2" header="{i18n>tilePOOpen}" subheader="{i18n>tilePOOpenSub}" class="sapUiTinyMarginEnd" press=".onTabPress">
                                    <customData><core:CustomData key="tab" value="orders"/></customData>
                                    <TileContent id="_IDGenTileContent2"><NumericContent id="_IDGenNumericContent2" value="{view>/counts/poOpen}" valueColor="Neutral"/></TileContent>
                                </GenericTile>
                                <GenericTile id="_IDGenGenericTile3" header="{i18n>tileAlertsOpen}" subheader="{i18n>tileAlertsOpenSub}" press=".onTabPress">
                                    <customData><core:CustomData key="tab" value="alerts"/></customData>
                                    <TileContent id="_IDGenTileContent3"><NumericContent id="_IDGenNumericContent3" value="{view>/counts/alertsOpen}" valueColor="Error"/></TileContent>
                                </GenericTile>
                            </HBox>

                            <Panel id="_IDGenPanel" headerText="{i18n>recentAlertsTitle}">
                                <Table id="_IDGenTable" items="{ path: '/AlertNotifications', sorter: { path: 'createdAt', descending: true } }" growing="true" growingThreshold="8">
                                    <columns>
                                        <Column id="_IDGenColumn"><Text id="_IDGenText1" text="{i18n>colAlertType}"/></Column>
                                        <Column id="_IDGenColumn1"><Text id="_IDGenText2" text="{i18n>colAlertMessage}"/></Column>
                                        <Column id="_IDGenColumn2"><Text id="_IDGenText3" text="{i18n>colAlertSeverity}"/></Column>
                                        <Column id="_IDGenColumn3"><Text id="_IDGenText4" text="{i18n>colAlertStatus}"/></Column>
                                        <Column id="_IDGenColumn4" hAlign="End"><Text id="_IDGenText5" text="{i18n>colAlertAction}"/></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem id="_IDGenColumnListItem">
                                            <cells>
                                                <Text id="_IDGenText6" text="{alertType}"/>
                                                <Text id="_IDGenText7" text="{message}"/>
                                                <ObjectStatus id="_IDGenObjectStatus" text="{severity}" state="{path:'severity', formatter:'.formatter.severityState'}"/>
                                                <ObjectStatus id="_IDGenObjectStatus1"
                                                    text="{= ${isResolved} ? ${i18n>alertStatusResolved} : ${i18n>alertStatusOpen} }"
                                                    state="{= ${isResolved} ? 'Success' : 'Warning' }"/>
                                                <Button id="_IDGenButton" text="{i18n>btnResolve}" type="Transparent" enabled="{= !${isResolved} }" press=".onResolveAlert"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </Panel>
                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter id="_IDGenIconTabFilter1" key="requisitions" text="{i18n>tabRequisitions}" icon="sap-icon://request">
                        <VBox id="_IDGenVBox2" class="sapUiSmallMargin">
                            <Toolbar id="_IDGenToolbar">
                                <Title id="_IDGenTitle1" text="{i18n>prSectionTitle}"/>
                                <ToolbarSpacer id="_IDGenToolbarSpacer"/>
                                <Button id="_IDGenButton1" text="{i18n>btnCreatePR}" type="Emphasized" icon="sap-icon://add" press=".onCreatePR"/>
                                <Button id="_IDGenButton2" icon="sap-icon://refresh" tooltip="{i18n>tooltipRefresh}" press=".onRefreshPRs"/>
                            </Toolbar>
                            <Table id="prTable" items="{ path: '/PurchaseRequisitions', sorter: { path: 'createdAt', descending: true } }" growing="true" growingThreshold="15">
                                <columns>
                                    <Column id="_IDGenColumn5"><Text id="_IDGenText8" text="{i18n>colPRNumber}"/></Column>
                                    <Column id="_IDGenColumn6"><Text id="_IDGenText9" text="{i18n>colLocationId}"/></Column>
                                    <Column id="_IDGenColumn7"><Text id="_IDGenText10" text="{i18n>colStatus}"/></Column>
                                    <Column id="_IDGenColumn8"><Text id="_IDGenText11" text="{i18n>colRequestedBy}"/></Column>
                                    <Column id="_IDGenColumn9"><Text id="_IDGenText12" text="{i18n>colApprovedBy}"/></Column>
                                    <Column id="_IDGenColumn10" hAlign="End"><Text id="_IDGenText13" text="{i18n>colActions}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="_IDGenColumnListItem1">
                                        <cells>
                                            <Text id="_IDGenText14" text="{prNumber}"/>
                                            <Text id="_IDGenText15" text="{location_ID}"/>
                                            <ObjectStatus id="_IDGenObjectStatus2" text="{status}" state="{path:'status', formatter:'.formatter.prStatusState'}"/>
                                            <Text id="_IDGenText16" text="{requestedBy}"/>
                                            <Text id="_IDGenText17" text="{approvedBy}"/>
                                            <HBox id="_IDGenHBox2">
                                                <Button id="_IDGenButton3" text="{i18n>btnSubmit}" type="Transparent" visible="{= ${status} === 'DRAFT' }" press=".onSubmitPR"/>
                                                <Button id="_IDGenButton4" text="{i18n>btnApprove}" type="Transparent" visible="{= ${status} === 'SUBMITTED' }" press=".onApprovePR"/>
                                                <Button id="_IDGenButton5" text="{i18n>btnReject}" type="Transparent" visible="{= ${status} === 'SUBMITTED' }" press=".onRejectPR"/>
                                                <Button id="_IDGenButton6" text="{i18n>btnCreatePOFromPR}" type="Transparent" visible="{= ${status} === 'APPROVED' }" press=".onCreatePOFromPR"/>
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter id="_IDGenIconTabFilter2" key="orders" text="{i18n>tabOrders}" icon="sap-icon://cart">
                        <VBox id="_IDGenVBox3" class="sapUiSmallMargin">
                            <Toolbar id="_IDGenToolbar1">
                                <Title id="_IDGenTitle2" text="{i18n>poSectionTitle}"/>
                                <ToolbarSpacer id="_IDGenToolbarSpacer1"/>
                                <Button id="_IDGenButton7" icon="sap-icon://refresh" tooltip="{i18n>tooltipRefresh}" press=".onRefreshPOs"/>
                            </Toolbar>
                            <Table id="poTable" items="{ path: '/PurchaseOrders', sorter: { path: 'createdAt', descending: true } }" growing="true" growingThreshold="15">
                                <columns>
                                    <Column id="_IDGenColumn11"><Text id="_IDGenText18" text="{i18n>colPONumber}"/></Column>
                                    <Column id="_IDGenColumn12"><Text id="_IDGenText19" text="{i18n>colSupplierId}"/></Column>
                                    <Column id="_IDGenColumn13"><Text id="_IDGenText20" text="{i18n>colSourcePR}"/></Column>
                                    <Column id="_IDGenColumn14"><Text id="_IDGenText21" text="{i18n>colStatus}"/></Column>
                                    <Column id="_IDGenColumn15"><Text id="_IDGenText22" text="{i18n>colS4POId}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="_IDGenColumnListItem2">
                                        <cells>
                                            <Text id="_IDGenText23" text="{poNumber}"/>
                                            <Text id="_IDGenText24" text="{supplier_ID}"/>
                                            <Text id="_IDGenText25" text="{pr_ID}"/>
                                            <ObjectStatus id="_IDGenObjectStatus3" text="{status}" state="{path:'status', formatter:'.formatter.poStatusState'}"/>
                                            <Text id="_IDGenText26" text="{s4POId}"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter id="_IDGenIconTabFilter3" key="gr" text="{i18n>tabGoodsReceipt}" icon="sap-icon://shipping-status">
                        <VBox id="_IDGenVBox4" class="sapUiSmallMargin">
                            <Toolbar id="_IDGenToolbar2">
                                <Title id="_IDGenTitle3" text="{i18n>grSectionTitle}"/>
                                <ToolbarSpacer id="_IDGenToolbarSpacer2"/>
                                <Button id="_IDGenButton8" text="{i18n>btnPostGR}" type="Emphasized" icon="sap-icon://add" press=".onPostGR"/>
                                <Button id="_IDGenButton9" icon="sap-icon://refresh" tooltip="{i18n>tooltipRefresh}" press=".onRefreshGRs"/>
                            </Toolbar>
                            <Table id="grTable" items="{ path: '/GoodsReceipts', sorter: { path: 'createdAt', descending: true } }" growing="true" growingThreshold="15">
                                <columns>
                                    <Column id="_IDGenColumn16"><Text id="_IDGenText27" text="{i18n>colGRNumber}"/></Column>
                                    <Column id="_IDGenColumn17"><Text id="_IDGenText28" text="{i18n>colPO}"/></Column>
                                    <Column id="_IDGenColumn18"><Text id="_IDGenText29" text="{i18n>colLocationId}"/></Column>
                                    <Column id="_IDGenColumn19"><Text id="_IDGenText30" text="{i18n>colReceivedBy}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="_IDGenColumnListItem3">
                                        <cells>
                                            <Text id="_IDGenText31" text="{grNumber}"/>
                                            <Text id="_IDGenText32" text="{po_ID}"/>
                                            <Text id="_IDGenText33" text="{location_ID}"/>
                                            <Text id="_IDGenText34" text="{receivedBy}"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter id="_IDGenIconTabFilter4" key="suppliers" text="{i18n>tabSuppliers}" icon="sap-icon://supplier">
                        <VBox id="_IDGenVBox5" class="sapUiSmallMargin">
                            <Toolbar id="_IDGenToolbar3">
                                <Title id="_IDGenTitle4" text="{i18n>suppliersSectionTitle}"/>
                                <ToolbarSpacer id="_IDGenToolbarSpacer3"/>
                                <Button id="_IDGenButton10" icon="sap-icon://refresh" tooltip="{i18n>tooltipRefresh}" press=".onRefreshSuppliers"/>
                            </Toolbar>
                            <Table id="_IDGenTable1" items="{/Suppliers}" growing="true" growingThreshold="20">
                                <columns>
                                    <Column id="_IDGenColumn20"><Text id="_IDGenText35" text="{i18n>colSupplierCode}"/></Column>
                                    <Column id="_IDGenColumn21"><Text id="_IDGenText36" text="{i18n>colSupplierName}"/></Column>
                                    <Column id="_IDGenColumn22"><Text id="_IDGenText37" text="{i18n>colEmail}"/></Column>
                                    <Column id="_IDGenColumn23"><Text id="_IDGenText38" text="{i18n>colPhone}"/></Column>
                                    <Column id="_IDGenColumn24"><Text id="_IDGenText39" text="{i18n>colRating}"/></Column>
                                    <Column id="_IDGenColumn25"><Text id="_IDGenText40" text="{i18n>colLeadTime}"/></Column>
                                    <Column id="_IDGenColumn26"><Text id="_IDGenText41" text="{i18n>colEligible}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="_IDGenColumnListItem4">
                                        <cells>
                                            <Text id="_IDGenText42" text="{supplierCode}"/>
                                            <Text id="_IDGenText43" text="{name}"/>
                                            <Text id="_IDGenText44" text="{email}"/>
                                            <Text id="_IDGenText45" text="{phone}"/>
                                            <ObjectNumber id="_IDGenObjectNumber" number="{rating}"/>
                                            <Text id="_IDGenText46" text="{leadTimeDays}"/>
                                            <core:Icon id="_IDGenIcon" src="{= ${isEligible} ? 'sap-icon://accept' : 'sap-icon://decline' }" color="{= ${isEligible} ? '#2b7d2b' : '#b00' }"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter id="_IDGenIconTabFilter5" key="alerts" text="{i18n>tabAlerts}" icon="sap-icon://alert">
                        <VBox id="_IDGenVBox6" class="sapUiSmallMargin">
                            <Toolbar id="_IDGenToolbar4">
                                <Title id="_IDGenTitle5" text="{i18n>alertsSectionTitle}"/>
                                <ToolbarSpacer id="_IDGenToolbarSpacer4"/>
                                <Button id="_IDGenButton11" icon="sap-icon://refresh" tooltip="{i18n>tooltipRefresh}" press=".onRefreshAlerts"/>
                            </Toolbar>
                            <Table id="alertsTable" items="{ path: '/AlertNotifications', sorter: { path: 'createdAt', descending: true } }" growing="true" growingThreshold="20">
                                <columns>
                                    <Column id="_IDGenColumn27"><Text id="_IDGenText47" text="{i18n>colAlertType}"/></Column>
                                    <Column id="_IDGenColumn28"><Text id="_IDGenText48" text="{i18n>colAlertMessage}"/></Column>
                                    <Column id="_IDGenColumn29"><Text id="_IDGenText49" text="{i18n>colAlertSeverity}"/></Column>
                                    <Column id="_IDGenColumn30"><Text id="_IDGenText50" text="{i18n>colAlertStatus}"/></Column>
                                    <Column id="_IDGenColumn31" hAlign="End"><Text id="_IDGenText51" text="{i18n>colAlertAction}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="_IDGenColumnListItem5">
                                        <cells>
                                            <Text id="_IDGenText52" text="{alertType}"/>
                                            <Text id="_IDGenText53" text="{message}"/>
                                            <ObjectStatus id="_IDGenObjectStatus4" text="{severity}" state="{path:'severity', formatter:'.formatter.severityState'}"/>
                                            <ObjectStatus id="_IDGenObjectStatus5"
                                                text="{= ${isResolved} ? ${i18n>alertStatusResolved} : ${i18n>alertStatusOpen} }"
                                                state="{= ${isResolved} ? 'Success' : 'Warning' }"/>
                                            <Button id="_IDGenButton12" text="{i18n>btnResolve}" type="Transparent" enabled="{= !${isResolved} }" press=".onResolveAlert"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>