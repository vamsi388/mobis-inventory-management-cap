<mvc:View
    controllerName="procurement.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    xmlns="sap.m"
>
    <tnt:ToolPage id="toolPage">

        <tnt:sideContent>
            <core:Fragment fragmentName="procurement.fragments.SideNav" type="XML"/>
        </tnt:sideContent>

        <tnt:mainContents>
            <Page id="mainPage" showHeader="false" busy="{view>/busy}" class="sapUiContentPadding">
                <content>
                    <core:Fragment fragmentName="procurement.fragments.DashboardSection" type="XML"/>
                    <core:Fragment fragmentName="procurement.fragments.RequisitionsSection" type="XML"/>
                    <core:Fragment fragmentName="procurement.fragments.OrdersSection" type="XML"/>
                    <core:Fragment fragmentName="procurement.fragments.GRSection" type="XML"/>
                    <core:Fragment fragmentName="procurement.fragments.SuppliersSection" type="XML"/>
                    <core:Fragment fragmentName="procurement.fragments.AlertsSection" type="XML"/>
                    <core:Fragment fragmentName="procurement.fragments.ProcessFlowSection" type="XML"/>
                    <core:Fragment fragmentName="procurement.fragments.AnalyticsSection" type="XML"/>
                    <core:Fragment fragmentName="procurement.fragments.SettingsSection" type="XML"/>
                    <core:Fragment fragmentName="procurement.fragments.SpendSection" type="XML"/>
                    <core:Fragment fragmentName="procurement.fragments.SupplierPerfSection" type="XML"/>
                    <core:Fragment fragmentName="procurement.fragments.UsersSection" type="XML"/>
                    <core:Fragment fragmentName="procurement.fragments.RolesSection" type="XML"/>
                </content>
            </Page>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>