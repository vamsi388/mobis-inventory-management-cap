<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">
    <Dialog id="createPRDialog" title="{i18n>createPRDialogTitle}" contentWidth="40rem" resizable="true">
        <content>
            <l:VerticalLayout class="sapUiContentPadding" width="100%">
                <l:content>
                    <Label text="{i18n>prLocationLabel}" labelFor="prLocationInput"/>
                    <Input id="prLocationInput" placeholder="{i18n>prLocationPlaceholder}" width="100%"/>

                    <Label text="{i18n>prRequestedByLabel}" labelFor="prRequestedByInput" class="sapUiTinyMarginTop"/>
                    <Input id="prRequestedByInput" placeholder="{i18n>prRequestedByPlaceholder}" width="100%"/>

                    <Toolbar class="sapUiTinyMarginTop">
                        <Title text="{i18n>prItemsTitle}" level="H5"/>
                        <ToolbarSpacer/>
                        <Button text="{i18n>btnAddItem}" icon="sap-icon://add" press=".onAddPRItemRow"/>
                    </Toolbar>

                    <Table items="{prItems>/items}" noDataText=" ">
                        <columns>
                            <Column><Text text="{i18n>colItemPart}"/></Column>
                            <Column><Text text="{i18n>colItemQty}"/></Column>
                            <Column><Text text="{i18n>colItemSupplier}"/></Column>
                            <Column><Text text="{i18n>colItemEstPrice}"/></Column>
                            <Column hAlign="End"><Text text=""/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Input value="{prItems>partId}"/>
                                    <Input value="{prItems>requiredQty}" type="Number"/>
                                    <Input value="{prItems>supplierId}"/>
                                    <Input value="{prItems>estimatedPrice}" type="Number"/>
                                    <Button icon="sap-icon://delete" type="Transparent" press=".onRemovePRItemRow"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </l:content>
            </l:VerticalLayout>
        </content>
        <beginButton>
            <Button text="{i18n>btnSave}" type="Emphasized" press=".onSavePR"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>btnCancel}" press=".onCancelPRDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>